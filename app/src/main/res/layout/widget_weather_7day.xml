<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Bar: App Title / Week Indicator, City Name with Location Pin, and Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="طقس ومطر • الأسبوع"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Location"
                android:src="@drawable/ic_weather_drop"
                android:tint="#38BDF8" />

            <TextView
                android:id="@+id/widget_location_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="المدينة"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_refresh_button"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_item_bg"
            android:contentDescription="Refresh"
            android:padding="5dp"
            android:src="@drawable/ic_weather_refresh" />
    </LinearLayout>

    <Spacer
        android:layout_width="match_parent"
        android:layout_height="6dp" />

    <!-- 7 Day Columns: Day Name, Icon, Temp Max, Temp Min, and Daily Rainfall Amount under them -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Day 0 -->
        <LinearLayout
            android:id="@+id/day_0_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day_0_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اليوم"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/day_0_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Day 0 Icon"
                android:src="@drawable/ic_weather_sun" />

            <TextView
                android:id="@+id/day_0_temp_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="28°"
                android:textColor="#FBBF24"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day_0_temp_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18°"
                android:textColor="#93C5FD"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/day_0_rain_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="0.0mm"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 1 -->
        <LinearLayout
            android:id="@+id/day_1_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day_1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="غداً"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/day_1_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Day 1 Icon"
                android:src="@drawable/ic_weather_cloud_sun" />

            <TextView
                android:id="@+id/day_1_temp_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="27°"
                android:textColor="#FBBF24"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day_1_temp_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17°"
                android:textColor="#93C5FD"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/day_1_rain_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="1.2mm"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 2 -->
        <LinearLayout
            android:id="@+id/day_2_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day_2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="يوم 3"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/day_2_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Day 2 Icon"
                android:src="@drawable/ic_weather_rain" />

            <TextView
                android:id="@+id/day_2_temp_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="24°"
                android:textColor="#FBBF24"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day_2_temp_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16°"
                android:textColor="#93C5FD"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/day_2_rain_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="6.5mm"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 3 -->
        <LinearLayout
            android:id="@+id/day_3_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day_3_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="يوم 4"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/day_3_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Day 3 Icon"
                android:src="@drawable/ic_weather_thunder" />

            <TextView
                android:id="@+id/day_3_temp_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="22°"
                android:textColor="#FBBF24"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day_3_temp_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15°"
                android:textColor="#93C5FD"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/day_3_rain_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="14.0mm"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 4 -->
        <LinearLayout
            android:id="@+id/day_4_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day_4_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="يوم 5"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/day_4_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Day 4 Icon"
                android:src="@drawable/ic_weather_cloud" />

            <TextView
                android:id="@+id/day_4_temp_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="25°"
                android:textColor="#FBBF24"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day_4_temp_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16°"
                android:textColor="#93C5FD"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/day_4_rain_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="0.5mm"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 5 -->
        <LinearLayout
            android:id="@+id/day_5_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day_5_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="يوم 6"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/day_5_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Day 5 Icon"
                android:src="@drawable/ic_weather_sun" />

            <TextView
                android:id="@+id/day_5_temp_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="28°"
                android:textColor="#FBBF24"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day_5_temp_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17°"
                android:textColor="#93C5FD"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/day_5_rain_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="0.0mm"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 6 -->
        <LinearLayout
            android:id="@+id/day_6_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day_6_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="يوم 7"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/day_6_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Day 6 Icon"
                android:src="@drawable/ic_weather_sun" />

            <TextView
                android:id="@+id/day_6_temp_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="29°"
                android:textColor="#FBBF24"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/day_6_temp_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18°"
                android:textColor="#93C5FD"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/day_6_rain_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="0.0mm"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <Spacer
        android:layout_width="match_parent"
        android:layout_height="4dp" />

    <!-- Weekly Continuous Line Chart showing rainfall amounts and temperature waves -->
    <ImageView
        android:id="@+id/widget_rain_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="مخطط الأمطار والحرارة الأسبوعي"
        android:scaleType="fitXY" />

</LinearLayout>
